{
  "name": "lottomind-news-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 8143\" \"node --env-file-if-exists=.env.local --import tsx --watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test": "tsx --test src/lib/news/*.test.ts server/account/*.test.ts",
    "provision:collectible": "tsx scripts/provision-collectible.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
